! INPUT FILE FOR FIELD LINE TRACING
!
&field_line_tracing_nml
!
  !time for tracing particles
  time_step = 1.0d0,!1.0d2 ,
!
  !Kinetic energy of particles
  energy_eV = 3.5d3 ,
!
  !Number of particles to be traced
  n_particles = 5.0d3,
!
  !Calculate intersections of field lines with phi = const. plane
  boole_poincare_plot = .false.,
!
  !Number of poincare mappings until tracing is terminated (even if time_step is not yet finished)
  n_poincare_mappings = 3000,
!
  !Number of poincare mappings which are ignored at the beginning of the run
  n_mappings_ignored = 10,
!
  !Calculate intersections of field lines with z = const. plane
  boole_divertor_intersection = .true.,
!
  !Z-value of divertor plate
  z_div_plate = -105d0,
!
  !Start all particles from the same physical position
  boole_point_source = .false.,
!
  !refined jacobian determinant
  boole_refined_sqrt_g = .true.,
!
  !work with monoenergetic particles instead of with boltzmann energies
  boole_monoenergetic = .false.,
!
  !make density a linear function of poloidal flux
  boole_linear_density_simulation = .false.,
!
  !make temperature a linear function of poloidal flux
  boole_linear_temperature_simulation = .false.,
!
  !Option for precomputation of above random numbers
  ! 1 ... compute seed with a random number
  ! 2 ... load seed from file 'seed.inp'
  seed_option = 2 ,
!
  !Read start points from file (R in cm, phi in rad, Z in cm; one per line, '#'/'!' comments) and trace each
  !start point in both directions (+1 along B, -1 against B) until it leaves the mesh. Replaces the built-in
  !start positions and n_particles; boole_monoenergetic is forced to .true.
  boole_start_points_file = .false. ,
  filename_start_points = 'field_line_start_points.dat' ,
!
  !Output: one line per (start point, direction): index, direction, status (1 left mesh, 0 not left within
  !max_arc_length, -1 start point not in mesh, -2 stopped: no progress), arc length s (m, geometric and v*t),
  !end point R (cm), phi (rad), Z (cm), number of tetrahedron pushings
  filename_exit_points = 'field_line_exits.dat' ,
!
  !Maximum arc length per direction in m (sets the tracing time; time_step is ignored in this mode)
  max_arc_length = 1.0d4 ,
!
  !Write trajectories (start index, direction, s (m), R (cm), phi (rad), Z (cm), |B| (G)) at every tetrahedron
  !face crossing for the start indices listed in traj_start_indices (up to 1000)
  boole_write_trajectories = .false. ,
  filename_trajectories = 'field_line_trajectories.dat' ,
  traj_start_indices = 0 ,
/

