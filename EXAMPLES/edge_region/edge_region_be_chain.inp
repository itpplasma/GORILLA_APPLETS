! Charge-state test: Be1+ -> 2+ -> 3+ -> 4+ with constant rates (Bateman chain)
&edge_region_nml
 species_element = 'Be' , start_charge = 1 , boole_gc_jump = .true. ,
 ionisation_rate_s(1) = 2.0d5 , ionisation_rate_s(2) = 1.0d5 , ionisation_rate_s(3) = 5.0d4 ,
 background_mass_amu = 2.01410177812 , background_charge_number = 1.0 ,
 electron_density_cm3 = 1.0d13 , temperature_ev = 20.0 ,
 boole_collisions = .true. , boole_electron_collisions = .true. ,
 start_mode = 'region' ,
 t_max_s = 2.0d-5 ,
 n_particles = 4000 , seed = 3 ,
 output_prefix = 'chain' ,
/
