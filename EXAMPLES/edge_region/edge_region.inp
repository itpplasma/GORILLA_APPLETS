! Edge-region impurity tracing (i_option = 17), see SRC/edge_region/edge_region_mod.f90
&edge_region_nml
 test_mass_amu = 183.84 , test_charge_number = 5.0 ,       ! W5+
 background_mass_amu = 2.01410177812 , background_charge_number = 1.0 ,  ! D+
 electron_density_cm3 = 1.0d13 , temperature_ev = 20.0 ,   ! constant n, T (Ti = Te)
 boole_collisions = .true. , boole_electron_collisions = .true. ,
 start_mode = 'point' , start_R_cm = 217.5 , start_Z_cm = 13.6 ,  ! outer midplane, mid SOL
 t_max_s = 1.0d-1 ,
 n_particles = 1000 , seed = 1 ,
 output_prefix = 'edge_region' ,
/
