! INPUT FILE FOR SELF CONSISTENT ELECTRIC FIELD
!
&self_consistent_ef_nml
!
  !time for tracing particles
  time_step = 1.0d3 ,
!
  !Kinetic energy of particles
  energy_eV = 3.5d3 ,
!
  !Number of species is usually 2, namely the ion species specified in gorilla.inp and electrons
  n_species = 2
!
  !Number of particles to be traced
  n_particles = 10d3 ,
!
  !Keep electron density constant
  boole_static_ne = .false. ,
!
  !Compute squares of moments 
  boole_squared_moments = .false.,
!
  !Start all particles from the same physical position
  boole_point_source = .false.,
!
  !include a collision operator
  boole_collisions = .true.,
!
  !precalcualte random numbers for collisions
  boole_precalc_collisions = .false.,
!
  !make collisions energy and momentum conserving
  boole_preserve_energy_and_momentum_during_collisions = .false.,
!
  !Number of electric potential updates
  n_electric_potential_updates = 10,
!
  !type of electric potential update
  !1 ... 1D (flux-surface averaged charge)
  !3 ... 3D (requires boole_honest_tracing = .true. for both species and n_source_updates = 0)
  update_dimension = 1
!
  !Simulated density of particles
  density = 3.0d13,
!
  !refined jacobian determinant, must be set to .false. since this can only be made use of in cylindrical coordinates
  boole_refined_sqrt_g = .false.,
!
  !work with monoenergetic particles instead of with boltzmann energies
  boole_monoenergetic = .false.,
!
  !make density a linear function of poloidal flux
  boole_linear_density_simulation = .false.,
!
  !always initiate pairs of particles where both particles start at the same position but move
  !in opposite direction, this helps to reduce statistical noise
  boole_antithetic_variate = .false.,
!
  !make temperature a linear function of poloidal flux
  boole_linear_temperature_simulation = .false.,
!
  !Set integrator type
  !(must be 1, otherwise it currently does not work)
  ! 1 ... GORILLA
  ! 2 ... DIRECT
  i_integrator_type = 1 ,
!
  !Option for precomputation of above random numbers
  ! 1 ... compute seed with a random number
  ! 2 ... load seed from file 'seed.inp'
  seed_option = 2

  !write data to files
  boole_write_vertex_indices = .true. ,
  boole_write_vertex_coordinates = .true. ,
  boole_write_prism_volumes = .true. ,
  boole_write_refined_prism_volumes = .false. , !Must be set to .false., since boole_refined_sqrt_g is also set to .false.
  boole_write_boltzmann_density = .false. ,
  boole_write_electric_potential = .false. ,
  boole_write_moments = .true. ,
  boole_write_fourier_moments = .true. ,
  boole_write_exit_data = .true. ,
  boole_write_grid_data = .true. ,
!
  !Per-species (1 = ion, 2 = electron) honest particle push (.true.) vs. random-walk substitute (.false.)
  boole_honest_tracing(1) = .false. ,
  boole_honest_tracing(2) = .false. ,
!
  !Per-species recompute of diffusion coefficients (.true.) or reuse cached A_and_B_species<species>.dat (.false.)
  boole_recompute_D(1) = .false. ,
  boole_recompute_D(2) = .false. ,
!
  !Outer source-tuning iterations (each does n_electric_potential_updates SCEF updates then updates the particle source)
  !0 = fixed source: a single SCEF round with a constant source equal to density, no source updates
  n_source_updates = 20 ,
!
  !Write output files only on the last electric-potential update per source iteration
  reduced_output = .false. ,
!
  !Relaxation factor alpha in S_new = S - alpha*(n - n_target)*exit_time_correction (0 < alpha <= 1)
  source_relaxation_factor = 1.0d0 ,
!
  !Intermediate source steps stop their electric potential updates early once
  !sum|n_e-n_i|V / sum(n_e+n_i)V <= quasineutrality_tol (0 = always run all updates).
  !The last source step always runs all n_electric_potential_updates.
  quasineutrality_tol = 0.1d0 ,
!
  !Collision operator (stost iswmode) for tracing and the diffusion calibration
  !1 ... full, 2 ... energy scattering and drag, 3 ... drag, 4 ... pitch-angle scattering only
  i_collision_mode = 1 ,
!
  !Test particles per flux surface in the diffusion calibration (boole_recompute_D = .true.)
  n_particles_diffusion = 40000 ,
!
  !Tracing time [s] of the diffusion calibration (<= 0: 3.4d-2 for ions, 3.4d-4 for electrons)
  diffusion_tau = -1.0d0 ,
!
  !> 0: tracing time of the diffusion calibration on each flux surface = diffusion_tau_collisions local
  !collision times tau_e (electrons) or tau_i (ions), NRL formulary at the target n, T (overrides diffusion_tau)
  diffusion_tau_collisions = -1.0d0 ,
!
  !Width in r/a of the outer buffer (1-width <= r/a <= 1). There the flux-shell densities, evaluated at the
  !outer edge of each shell, are blended with a cosine weight from the marker density (inner edge) to the
  !target density (boundary), and the particle source is not tuned (0 = off)
  edge_buffer_width = 0.1d0 ,
!
  !> 0: stop early once the result is within the Monte Carlo noise. The noise levels of the quasineutrality
  !mismatch and of the source residual |n - n_target| are estimated from the per-marker density
  !contributions per flux shell. Potential updates of an intermediate source step stop once the mismatch
  !is <= noise_tolerance_factor * its noise level; the source iteration stops once residual and mismatch
  !are both within that factor in two consecutive source steps (0 = off; 1D updates only)
  noise_tolerance_factor = 0.0d0 ,
!
  !> 0: calibrate only the flux surface closest to this s, write exit_s_values_species<k>_<ns>.dat
  !and A_and_B_scan_species<k>.dat, then stop without SCEF iterations (<= 0: all surfaces, then SCEF)
  diffusion_scan_s0 = -1.0d0
/
